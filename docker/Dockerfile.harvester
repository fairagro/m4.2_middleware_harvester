# syntax=docker/dockerfile:1.4
# Product-local last stage for harvester (NOT synced). Bake wires context
# `export_bins` → shared base `export-binaries` and `healthcheck_bins` →
# product-local healthcheck export (see docker-bake.hcl).
#
# Pins: ALPINE_VERSION from versions.env (no literal pin here).

ARG ALPINE_VERSION
FROM alpine:${ALPINE_VERSION}

ARG BINARY_NAME=harvester
ARG RUNTIME_USER=harvester
ARG RUNTIME_UID=65532
ARG RUNTIME_GID=65532
ARG RUNTIME_WORKDIR=/middleware

ENV BINARY_NAME=${BINARY_NAME}

WORKDIR ${RUNTIME_WORKDIR}

# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates zlib \
    && addgroup -S -g "${RUNTIME_GID}" "${RUNTIME_USER}" \
    && adduser -S -u "${RUNTIME_UID}" -H -G "${RUNTIME_USER}" "${RUNTIME_USER}" \
    && chown "${RUNTIME_USER}:${RUNTIME_USER}" "${RUNTIME_WORKDIR}"

# Primary onedir from shared product-app.base export-binaries
# hadolint ignore=DL3022
COPY --chown=${RUNTIME_USER}:${RUNTIME_USER} --from=export_bins /dist/${BINARY_NAME} ${RUNTIME_WORKDIR}/${BINARY_NAME}

# Standalone liveness binary (product-local Bake target; see openspec design D-healthcheck)
# hadolint ignore=DL3022
COPY --chown=${RUNTIME_USER}:${RUNTIME_USER} --from=healthcheck_bins /dist/healthcheck ${RUNTIME_WORKDIR}/${BINARY_NAME}/healthcheck

USER ${RUNTIME_USER}

ENTRYPOINT ["/middleware/harvester/harvester"]
