{
  // Single markdownlint config for VS Code (davidanson.vscode-markdownlint) and CLI
  // (npx markdownlint-cli2 "**/*.md"). Same engine; this file is the only source of truth.
  "config": {
    "MD013": {
      "line_length": 200,
      "code_blocks": false,
      "tables": false,
      "headings": false
    }
  },
  "ignores": [
    // OpenSpec-managed / generated by `openspec init` — do not hand-lint for style.
    "openspec/**",
    ".cursor/commands/opsx-*.md",
    ".cursor/skills/openspec-*/**",
    ".github/prompts/opsx-*",
    ".github/skills/openspec-*/**",
    // Dependencies / build artifacts
    ".venv/**",
    "**/node_modules/**",
    "**/site-packages/**"
  ]
}
