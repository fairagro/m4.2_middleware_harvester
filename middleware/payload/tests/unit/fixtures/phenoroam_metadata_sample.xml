            <pr:blockStudyParent>
              <pr:blockStudy>
                <pr:itemTitle>Nutrient imbalance trials at long-term fertilizer field trial at experimental station of University of Halle (Saale)</pr:itemTitle>
                <pr:itemDescription>Various crops grown under various fertilizer managements in field</pr:itemDescription>
                <pr:blockInvestigation>
                  <pr:itemTitle>Non-invasive detection of nutrient imbalances in important field crops</pr:itemTitle>
                  <pr:itemDescription>Various broadacre crops are exposed to nutrient imbalances in hydroponic culture, in potted soil, in miniplots and in long-term fertilizer field-trials and traits are recorded.</pr:itemDescription>
                </pr:blockInvestigation>
              </pr:blockStudy>
            </pr:blockStudyParent>
