                  <pr:itemName>Lukas Drees</pr:itemName>
                  <pr:itemEmail>ldrees@uni-bonn.de</pr:itemEmail>
                  <pr:itemAffiliation>University of Bonn</pr:itemAffiliation>
                </pr:blockPerson>
              </pr:blockResponsibleContact>
            </pr:blockContacts>
            <pr:blockStudyParent>
              <pr:blockStudy>
                <pr:itemTitle>Growth Analysis of Mixed Cropping</pr:itemTitle>
                <pr:itemDescription>Attempt to capture and analyze the growth behavior and the different expressions and developments of mixture partners over time in an image-based way.</pr:itemDescription>
                <pr:blockInvestigation>
                  <pr:itemTitle>Image Generation of Mixtures</pr:itemTitle>
                  <pr:itemDescription>Generation of a data-based growth model from the multi-temporal imagery that can generate new images of intermediate or future above ground phenotypes of crop mixtures.</pr:itemDescription>
                </pr:blockInvestigation>
              </pr:blockStudy>
            </pr:blockStudyParent>
          </pr:blockGeneral>
