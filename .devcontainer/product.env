# Product-owned Dev Container env (not synced). Loaded via Compose env_file;
# re-read by scripts/run-quality-cli.sh and reusable code-quality when MYPYPATH /
# PYLINT_SOURCE_ROOTS are unset (see docs/ci.md, docs/quality.md). Single source
# for local hooks and CI — do not duplicate these strings in workflow `with:`.
# No stubs/ tree: fleet arctrl/fable silenced in synced mypy.ini; owslib via call-site
# `# type: ignore[import-untyped]` (issue #257).
MYPYPATH=middleware/inspire/src:middleware/harvester/src:middleware/linked_data/src:middleware/generic/src:middleware/payload/src:middleware/linked_data/tests/unit:middleware/inspire/tests/unit:middleware/payload/tests/unit
PYLINT_SOURCE_ROOTS=middleware/linked_data/tests/unit,middleware/inspire/tests/unit,middleware/payload/tests/unit
CST_BAKE_TARGET=harvester
