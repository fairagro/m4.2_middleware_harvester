  "cards": [
    {
      "dot": "cyan",
      "title": "Plugin contract",
      "items": [
        "Each plugin.run() is an AsyncGenerator yielding HarvestedArc, HarvesterError or SkippedRecord",
        "Orchestrator picks the class from PLUGIN_FACTORIES by the repo's plugin block"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared registries",
      "items": [
        "middleware.parsing: PayloadParser (html_jsonld, jsonld, phenoroam_xml, rdf_xml)",
        "middleware.payload: DataMapper selected by the sibling mapper.type"
      ]
    },
    {
      "dot": "amber",
      "title": "Run & report",
      "items": [
        "Repositories harvest concurrently via asyncio.gather",
        "Outcomes recorded on HarvestReport, emitted as JSON-LD to stdout",
        "Real OpenAgrar is behind a PoW gate (#271); a local fixture stands in"
      ]
    },
    {
      "dot": "violet",
      "title": "RDI status",
      "items": [
        "in test: SRADI, PlabiPD, PhenoRoam, BonaRes Klib, DWD, Edaphobase",
        "dev/test: BonaRes, Thünen-Atlas, e!DAL-PGP, PUBLISSO FRL, OpenAgrar (fixture)",
        "not started: JKI DataCube (WCS, no plugin yet; m4_rdi_portfolio#1), LIMS, GBIS (via sql_to_arc)",
        "SQL sources go through the separate sql_to_arc service, not a harvester plugin",
        "Not on main: Klib (follows its design), PlabiPD (branch feat/plabipd-linked-data-source); DWD is commented out and Thünen-Atlas has no config entry"
      ]
    }
  ]
